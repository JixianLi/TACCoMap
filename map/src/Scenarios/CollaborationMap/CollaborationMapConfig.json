{
    "name": "TACC collaboration map",
    "description": "Institutions that work with TACC, 2001–present",
    "views": ["Map", "Filters", "Details", "Timeline"],
    "panel_layouts": {
        "default_layouts": {
            "xl": [
                {"i": "Map", "type": "borderless", "x": 0, "y": 0, "w": 18, "h": 13, "visible": true},
                {"i": "Timeline", "x": 0, "y": 13, "w": 18, "h": 5, "visible": true},
                {"i": "Filters", "x": 18, "y": 0, "w": 6, "h": 10, "visible": true},
                {"i": "Details", "x": 18, "y": 10, "w": 6, "h": 8, "visible": true}
            ],
            "lg": [
                {"i": "Map", "type": "borderless", "x": 0, "y": 0, "w": 8, "h": 12, "visible": true},
                {"i": "Timeline", "x": 0, "y": 12, "w": 8, "h": 5, "visible": true},
                {"i": "Filters", "x": 8, "y": 0, "w": 4, "h": 9, "visible": true},
                {"i": "Details", "x": 8, "y": 9, "w": 4, "h": 8, "visible": true}
            ],
            "sm": [
                {"i": "Map", "type": "borderless", "x": 0, "y": 0, "w": 4, "h": 9, "visible": true},
                {"i": "Timeline", "x": 0, "y": 9, "w": 4, "h": 5, "visible": true},
                {"i": "Details", "x": 0, "y": 14, "w": 4, "h": 7, "visible": true},
                {"i": "Filters", "x": 0, "y": 21, "w": 4, "h": 12, "visible": true}
            ]
        },
        "breakpoints": {"xl": 1440, "lg": 800, "sm": 0},
        "cols": {"xl": 24, "lg": 12, "sm": 4},
        "fit_rows": {"sm": 13}
    },
    "global_data": {
        "data_url": "data/map_institutions.json",
        "browser_base_url": "http://localhost:8000/"
    }
}
